<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="闲页 · TXT 阅读器" Width="960" Height="680" MinWidth="380" MinHeight="220"
        WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource PaperBrush}" FontFamily="Microsoft YaHei UI"
        FontSize="13" Foreground="{DynamicResource TextBrush}" AllowDrop="True" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="PaperBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="TextBrush" Color="#D4D4D4"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#969696"/>
    <SolidColorBrush x:Key="FrameBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#303030"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#D4D4D4"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
    <Style TargetType="ContextMenu">
      <Setter Property="Background" Value="{DynamicResource PaperBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
        <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource SelectionBrush}" BorderThickness="1" Padding="5"><ItemsPresenter/></Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="MenuItem">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
        <Border x:Name="MenuBorder" Background="Transparent" Padding="12,9"><ContentPresenter ContentSource="Header"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuBorder" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Slider">
      <Setter Property="Height" Value="20"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
        <Grid Background="Transparent">
          <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
            <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="3" VerticalAlignment="Center" Background="{DynamicResource MutedBrush}"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
            <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="3" VerticalAlignment="Center" Background="{DynamicResource SelectionBrush}"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
            <Track.Thumb><Thumb Width="12" Height="16"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource TextBrush}" CornerRadius="3"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          </Track>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Padding" Value="12,8"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/><Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="10,12"/><Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SelectionBrush}"/></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
      </Style></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Border x:Name="OuterBorder" BorderBrush="{DynamicResource FrameBrush}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition x:Name="HeaderRow" Height="48"/><RowDefinition Height="*"/><RowDefinition x:Name="StatusRow" Height="33"/></Grid.RowDefinitions>
      <Border x:Name="TitleBar" Background="{DynamicResource PaperBrush}" BorderBrush="{DynamicResource FrameBrush}" BorderThickness="0,0,0,1">
        <Grid Margin="10,0,6,0"><Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="LibraryToggle" Content="☰" FontSize="17" Padding="10,5" ToolTip="书架 / 目录"/>
            <TextBlock x:Name="Brand" Text="闲页" FontSize="18" FontWeight="SemiBold" Margin="9,0,0,0" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="ImportButton" Content="＋ 导入" ToolTip="导入 TXT · Ctrl+O" Padding="10,7"/>
            <Button x:Name="PinButton" Content="已置顶" ToolTip="切换窗口置顶 · Ctrl+T" Padding="10,7"/>
            <Button x:Name="SettingsButton" Content="Aa" FontSize="16" ToolTip="阅读外观" Padding="10,6"/>
            <Button x:Name="BossButton" Content="退出" Background="{DynamicResource SelectionBrush}" Foreground="{DynamicResource TextBrush}" ToolTip="老板键：立即退出并保存 · Ctrl+Alt+Q（全局） / Esc" Padding="12,7" Margin="4,0"/>
            <Button x:Name="MinimizeButton" Content="─" Padding="10,7" ToolTip="最小化"/>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SideColumn" Width="208"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border x:Name="Sidebar" Background="{DynamicResource PaperBrush}" BorderBrush="{DynamicResource FrameBrush}" BorderThickness="0,0,1,0">
          <Grid Margin="16,22,12,14">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="我的阅读空间" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="8,0,0,18"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
              <Button x:Name="BooksTab" Content="书架" FontWeight="SemiBold" Background="{DynamicResource SelectionBrush}"/>
              <Button x:Name="ChaptersTab" Content="目录" Margin="5,0,0,0"/>
            </StackPanel>
            <ListBox x:Name="BookList" Grid.Row="2">
              <ListBox.ItemTemplate><DataTemplate><StackPanel>
                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" ToolTip="{Binding Title}"/>
                <TextBlock Text="{Binding Progress, StringFormat=已读 {0:P1}}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/>
              </StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <ListBox x:Name="ChapterList" Grid.Row="2" Visibility="Collapsed">
              <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="12"/></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="ShelfHint" Grid.Row="3" Text="本地阅读 · 自动记忆进度" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="7,14,0,0"/>
          </Grid>
        </Border>
        <Grid Grid.Column="1" x:Name="ReadingPanel">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel x:Name="BookHeading" Margin="34,28,34,18">
            <TextBlock x:Name="BookCaption" Text="QUIET READER / 慢一点，也很好" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
            <TextBlock x:Name="BookTitle" Text="给自己，留一页闲暇。" FontSize="24" FontWeight="SemiBold" Margin="0,9,0,0" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <TextBox x:Name="Reader" Grid.Row="1" Margin="30,0,20,6" Padding="4,0,10,12"
            BorderThickness="0" Background="Transparent" IsReadOnly="True" IsReadOnlyCaretVisible="False"
            AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Microsoft YaHei" FontSize="19"
            IsUndoEnabled="False" SpellCheck.IsEnabled="False" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed"
            TextOptions.TextFormattingMode="Ideal" AutomationProperties.Name="小说正文"/>
          <StackPanel x:Name="Welcome" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,0,20,40">
            <Border Background="{DynamicResource SelectionBrush}" Width="72" Height="78" CornerRadius="10" HorizontalAlignment="Center" Margin="0,0,0,24">
              <TextBlock Text="页" FontSize="34" FontFamily="Microsoft YaHei" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="把故事带进来" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="拖入一个 TXT，或从电脑中选择小说。" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,24" TextAlignment="Center" TextWrapping="Wrap"/>
            <Button x:Name="WelcomeImport" Content="选择 TXT 文件   →" Background="{DynamicResource SelectionBrush}" Padding="24,13" HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock Text="自动保存进度 · 下次接着读" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,18,0,0" HorizontalAlignment="Center"/>
          </StackPanel>
          <Grid x:Name="ReadingFooter" Grid.Row="2" Margin="34,8,30,16" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="PreviousButton" Content="← 上一页" Padding="10,7"/>
            <Slider x:Name="ProgressSlider" Grid.Column="1" Minimum="0" Maximum="100" VerticalAlignment="Center" Margin="20,0" ToolTip="拖动跳转阅读位置" IsMoveToPointEnabled="True" AutomationProperties.Name="阅读进度"/>
            <Button x:Name="NextButton" Grid.Column="2" Content="下一页 →" Padding="10,7"/>
          </Grid>
          <Border x:Name="CompactDragArea" Grid.RowSpan="3" Height="24" VerticalAlignment="Top" Background="Transparent" Cursor="SizeAll" Visibility="Collapsed" Panel.ZIndex="1"/>
        </Grid>
      </Grid>
      <Border x:Name="StatusBar" Grid.Row="2" Background="{DynamicResource PaperBrush}" BorderBrush="{DynamicResource FrameBrush}" BorderThickness="0,1,0,0">
        <Grid Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="StatusText" Text="就绪 · Ctrl+O 导入 TXT" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="BossHint" Grid.Column="1" Text="老板键  Ctrl+Alt+Q" FontSize="10" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="15,0,0,0"/>
        </Grid>
      </Border>
      <Thumb x:Name="ResizeCorner" Grid.Row="2" Width="15" Height="15" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" ToolTip="拖动调整窗口大小">
        <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent"><Path Data="M 5,13 L 13,5 M 9,13 L 13,9" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1"/></Border></ControlTemplate></Thumb.Template>
      </Thumb>
      <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsButton}" Placement="Bottom" HorizontalOffset="-240" StaysOpen="False" AllowsTransparency="True">
        <Border Background="{DynamicResource PaperBrush}" BorderBrush="{DynamicResource FrameBrush}" BorderThickness="1" CornerRadius="9" Padding="22" Width="300" Margin="6">
          <StackPanel x:Name="SettingsRoot">
            <TextBlock Text="让阅读舒服一点" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,20"/>
            <TextBlock Text="纸张颜色" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,9"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <Button x:Name="PaperTheme" Content="纸白" Background="#F7F5EF" Foreground="#333B36" Padding="10,9"/>
              <Button x:Name="GreenTheme" Content="苔绿" Background="#DDE7D6" Foreground="#354431" Margin="5,0" Padding="10,9"/>
              <Button x:Name="DarkTheme" Content="VS Code" Background="#1E1E1E" Foreground="#D4D4D4" Padding="10,9"/>
              <Button x:Name="GrayTheme" Content="雾灰" Background="#E7E9EB" Foreground="#37434B" Padding="10,9" Margin="5,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
              <Button x:Name="CustomBackground" Content="自定义背景" Background="{DynamicResource SelectionBrush}" Padding="12,8"/>
              <Button x:Name="CustomForeground" Content="文字颜色" Padding="12,8"/>
            </StackPanel>
            <DockPanel><TextBlock Text="文字大小"/><TextBlock x:Name="FontLabel" Text="19 px" HorizontalAlignment="Right"/></DockPanel>
            <Slider x:Name="FontSlider" Minimum="12" Maximum="36" Value="19" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,12,0,20" AutomationProperties.Name="文字大小"/>
            <DockPanel><TextBlock Text="窗口不透明度"/><TextBlock x:Name="OpacityLabel" Text="100%" HorizontalAlignment="Right"/></DockPanel>
            <Slider x:Name="OpacitySlider" Minimum="0.3" Maximum="1" Value="1" SmallChange="0.01" LargeChange="0.05" IsMoveToPointEnabled="True" IsSnapToTickEnabled="False" Margin="0,12,0,18" AutomationProperties.Name="窗口不透明度"/>
            <Button x:Name="CompactButton" Content="进入无边框小窗   Ctrl+M" Background="{DynamicResource SelectionBrush}" Margin="0,0,0,16"/>
            <TextBlock x:Name="HotkeyStatus" Text="Ctrl+Alt+Q 全局退出；Esc 窗口内退出。" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
            <TextBlock Text="右键菜单 · Ctrl+M 还原 · 顶部空白区拖动小窗" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
          </StackPanel>
        </Border>
      </Popup>
    </Grid>
  </Border>
</Window>
